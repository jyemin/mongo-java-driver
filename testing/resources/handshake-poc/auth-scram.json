{
  "description": "handshake-auth-scram",
  "schemaVersion": "1.27",
  "runOnRequirements": [
    {
      "minServerVersion": "4.4",
      "auth": true
    }
  ],
  "createEntities": [
    {
      "client": {
        "id": "client",
        "useMultipleMongoses": false,
        "setEnvironment": {
          "AWS_EXECUTION_ENV": null,
          "AWS_LAMBDA_RUNTIME_API": null,
          "FUNCTIONS_WORKER_RUNTIME": null,
          "K_SERVICE": null,
          "FUNCTION_NAME": null,
          "VERCEL": null,
          "KUBERNETES_SERVICE_HOST": null
        },
        "uriOptions": {
          "authMechanism": "SCRAM-SHA-256"
        },
        "observeWireMessages": {
          "connections": [
            "application"
          ],
          "phases": [
            "handshake"
          ]
        }
      }
    },
    {
      "database": {
        "id": "database",
        "client": "client",
        "databaseName": "handshake-test"
      }
    }
  ],
  "tests": [
    {
      "description": "speculative SCRAM-SHA-256 handshake and the saslContinue that follows",
      "operations": [
        {
          "name": "runCommand",
          "object": "database",
          "arguments": {
            "commandName": "ping",
            "command": {
              "ping": 1
            }
          }
        }
      ],
      "expectWireMessages": [
        {
          "client": "client",
          "messages": [
            {
              "opcode": "OP_QUERY",
              "responseTo": 0,
              "flags": [],
              "fullCollectionName": "admin.$cmd",
              "numberToSkip": 0,
              "numberToReturn": -1,
              "command": {
                "isMaster": 1,
                "helloOk": true,
                "backpressure": "2",
                "client": {
                  "application": {
                    "name": "client"
                  },
                  "driver": {
                    "name": {
                      "$$type": "string"
                    },
                    "version": {
                      "$$type": "string"
                    }
                  },
                  "os": {
                    "type": {
                      "$$type": "string"
                    },
                    "name": {
                      "$$unsetOrMatches": {
                        "$$type": "string"
                      }
                    },
                    "architecture": {
                      "$$unsetOrMatches": {
                        "$$type": "string"
                      }
                    },
                    "version": {
                      "$$unsetOrMatches": {
                        "$$type": "string"
                      }
                    }
                  },
                  "platform": {
                    "$$unsetOrMatches": {
                      "$$type": "string"
                    }
                  },
                  "env": {
                    "$$unsetOrMatches": {
                      "container": {
                        "runtime": "docker"
                      }
                    }
                  }
                },
                "speculativeAuthenticate": {
                  "saslStart": 1,
                  "mechanism": "SCRAM-SHA-256",
                  "payload": {
                    "$$type": "binData"
                  },
                  "db": "admin",
                  "options": {
                    "skipEmptyExchange": true
                  }
                }
              }
            },
            {
              "opcode": "OP_MSG",
              "responseTo": 0,
              "flags": [],
              "command": {
                "saslContinue": 1,
                "conversationId": {
                  "$$type": "int"
                },
                "payload": {
                  "$$type": "binData"
                },
                "$db": "admin"
              }
            }
          ]
        }
      ]
    }
  ]
}
